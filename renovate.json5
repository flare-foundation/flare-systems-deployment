{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'gitlab>flarenetwork/infra-team/renovate:best-practices.json5',
    'group:allNonMajor',
  ],
  packageRules: [
    {
      groupName: "Image deps",
      matchManagers: [
        "dockerfile",
        "docker-compose",
        "gitlabci",
        "gitlabci-include"
      ]
    }
  ]
}
